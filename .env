# HTTP-сервер
PORT=8080

# Подключение к базе (Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviewers?sslmode=disable

# Таймауты HTTP-сервера
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Логирование
LOG_LEVEL=debug

# Токены для авторизации
ADMIN_TOKEN=super-secret-admin
USER_TOKEN=super-secret-user
